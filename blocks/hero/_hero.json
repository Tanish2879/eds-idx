{
  "definitions": [
    {
      "title": "Hero",
      "id": "hero",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero",
              "model": "hero",
              "filter": "hero"
            }
          }
        }
      }
    },
    {
      "title": "Hero Slide",
      "id": "hero-slide",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Hero Slide",
              "model": "hero-slide"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "hero",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image or Video (Desktop)",
          "required": true,
          "condition": { "and": [{ "!==": [{ "var": "classes" }, "carousel"] }, { "!==": [{ "var": "classes" }, "tech-slides"] }, { "!==": [{ "var": "classes" }, "statement"] }] },
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "mobileImage",
          "label": "Background Image or Video (Mobile)",
          "description": "Optional. Uses the desktop one if empty.",
          "condition": { "and": [{ "!==": [{ "var": "classes" }, "carousel"] }, { "!==": [{ "var": "classes" }, "tech-slides"] }, { "!==": [{ "var": "classes" }, "statement"] }] },
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "condition": { "and": [{ "!==": [{ "var": "classes" }, "carousel"] }, { "!==": [{ "var": "classes" }, "tech-slides"] }, { "!==": [{ "var": "classes" }, "statement"] }] },
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "thumbnail",
          "label": "Video Thumbnail (Desktop)",
          "description": "Optional. Image shown until the video plays. Product: the Watch the film card image. Dealer: the product card image.",
          "condition": { "and": [{ "!==": [{ "var": "classes" }, "carousel"] }, { "!==": [{ "var": "classes" }, "tech-slides"] }, { "!==": [{ "var": "classes" }, "statement"] }] },
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "mobileThumbnail",
          "label": "Video Thumbnail (Mobile)",
          "description": "Optional. Only used for a video on mobile. Uses the desktop thumbnail if empty.",
          "condition": { "and": [{ "!==": [{ "var": "classes" }, "carousel"] }, { "!==": [{ "var": "classes" }, "tech-slides"] }, { "!==": [{ "var": "classes" }, "statement"] }] },
          "multi": false
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text",
          "description": "Heading, text and buttons. Tech Slides: label/value pairs become stats. Product and Dealer: title as Heading 1, then their card, price and buttons in order.",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "manifesto",
          "label": "Scroll Manifesto (Editorial and Intro)",
          "description": "Editorial and Intro styles only. Appears on scroll.",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundImage",
          "label": "Background Image",
          "description": "Showcase only. Optional. A decorative layer behind the main image, e.g. a sky behind a cut-out car photo.",
          "condition": { "===": [{ "var": "classes" }, "showcase"] },
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "logo",
          "label": "Logo (Product)",
          "description": "Product only. The model's logo or lockup, shown above the title.",
          "condition": { "===": [{ "var": "classes" }, "product"] },
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "logoAlt",
          "label": "Logo Alt Text",
          "condition": { "===": [{ "var": "classes" }, "product"] },
          "value": ""
        },
        {
          "component": "select",
          "name": "classes",
          "label": "Style",
          "description": "Carousel and Tech Slides: up to 3 slides. Product: launch hero; the Background Image is the full scene. Dealer: storefront hero with a product card.",
          "value": "",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Editorial", "value": "editorial" },
            { "name": "Teaser", "value": "teaser" },
            { "name": "Showcase", "value": "showcase" },
            { "name": "Carousel", "value": "carousel" },
            { "name": "Intro", "value": "intro" },
            { "name": "Statement", "value": "statement" },
            { "name": "Tech Slides", "value": "tech-slides" },
            { "name": "Product", "value": "product" },
            { "name": "Dealer", "value": "dealer" }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_opening",
          "label": "Opening Animation",
          "description": "Carousel only. The first slide opens as a small centred card, then fills the screen; the first two Text paragraphs sit either side of it.",
          "condition": { "===": [{ "var": "classes" }, "carousel"] }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_showroom",
          "label": "Showroom Layout",
          "description": "Carousel only. Text's first paragraphs become the eyebrow; paragraphs starting with a bold label become info card rows.",
          "condition": { "===": [{ "var": "classes" }, "carousel"] }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_thumbs-bottom",
          "label": "Thumbnails at the Bottom",
          "description": "Carousel only. Moves the thumbnails to a row at the bottom right and keeps the heading and text clear of them and of the Test Drive strip.",
          "condition": { "===": [{ "var": "classes" }, "carousel"] }
        },
        {
          "component": "select",
          "name": "classes_align",
          "label": "Heading Position",
          "description": "Moves the heading only; text and buttons keep the style's layout. Default follows the style.",
          "value": "",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Left", "value": "align-left" },
            { "name": "Center", "value": "align-center" },
            { "name": "Right", "value": "align-right" }
          ]
        }
      ]
    },
    {
      "id": "hero-slide",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Background Image or Video (Desktop)",
          "required": true,
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt Text",
          "value": ""
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "mobileImage",
          "label": "Background Image or Video (Mobile)",
          "description": "Optional. Uses the desktop one if empty.",
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "thumbnail",
          "label": "Thumbnail (Desktop)",
          "description": "Optional. Tech Slides: the close-up tile. Carousel: the video's poster and slide strip image.",
          "multi": false
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "mobileThumbnail",
          "label": "Thumbnail (Mobile)",
          "description": "Carousel: only used for a video on mobile. Uses the desktop thumbnail if empty. Optional.",
          "multi": false
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "videoControls",
          "label": "Enable Video Control",
          "description": "Shows mute and pause buttons when this slide is a video."
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Text",
          "description": "Optional. This slide's heading, text and buttons; uses the Hero's Text when empty. Tech Slides: label, heading, description, stats, button.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tilePosition",
          "label": "Tile Position",
          "description": "Tech Slides only. Written as: x, y (e.g. 33, 61). You can drag the tile to any position in preview mode.",
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^(\\s*(\\d{1,2}(\\.\\d+)?|100)\\s*,\\s*(\\d{1,2}(\\.\\d+)?|100)\\s*)?$",
            "customErrorMsg": "Write it as x, y: two numbers from 0 to 100, e.g. 33, 61."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tilePositionMobile",
          "label": "Tile Position (Mobile)",
          "description": "Tech Slides only. Optional, written as: x, y. Uses Tile Position if empty. Drag the tile at mobile size in preview mode.",
          "value": "",
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^(\\s*(\\d{1,2}(\\.\\d+)?|100)\\s*,\\s*(\\d{1,2}(\\.\\d+)?|100)\\s*)?$",
            "customErrorMsg": "Write it as x, y: two numbers from 0 to 100, e.g. 50, 70."
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "hero",
      "components": [
        "hero-slide"
      ],
      "rte": {
        "toolbar": {
          "format": ["bold", "italic", "underline", "strike", "code_inline", "text_color"],
          "alignment": ["left", "center", "right", "justify"],
          "direction": ["rtl", "ltr"],
          "indentation": ["indent", "outdent"],
          "blocks": ["paragraph", "h1", "h2", "h3", "h4", "h5", "h6", "code_block", "blockquote"],
          "list": ["bullet_list", "ordered_list"],
          "insert": ["link", "unlink", "image", "table", "special_characters"],
          "sr_script": ["superscript", "subscript"],
          "editor": ["removeformat", "clean_unsupported_tags", "paste_text", "fullscreen", "find_and_replace"],
          "sections": ["blocks", "format", "alignment", "direction", "indentation", "list", "insert", "sr_script", "editor"]
        }
      }
    },
    {
      "id": "hero-full",
      "components": [],
      "rte": {
        "toolbar": {
          "format": ["bold", "italic", "underline", "strike", "code_inline", "text_color"],
          "alignment": ["left", "center", "right", "justify"],
          "direction": ["rtl", "ltr"],
          "indentation": ["indent", "outdent"],
          "blocks": ["paragraph", "h1", "h2", "h3", "h4", "h5", "h6", "code_block", "blockquote"],
          "list": ["bullet_list", "ordered_list"],
          "insert": ["link", "unlink", "image", "table", "special_characters"],
          "sr_script": ["superscript", "subscript"],
          "editor": ["removeformat", "clean_unsupported_tags", "paste_text", "fullscreen", "find_and_replace"],
          "sections": ["blocks", "format", "alignment", "direction", "indentation", "list", "insert", "sr_script", "editor"]
        }
      }
    }
  ]
}
