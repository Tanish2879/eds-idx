        {
          "component": "aem-content",
          "valueType": "string",
          "name": "privacyEmail",
          "label": "Privacy contact email",
          "description": "Shown as a link after the disclaimer: the address as mailto:…, e.g. mailto:privacy@jswmotors.com."
