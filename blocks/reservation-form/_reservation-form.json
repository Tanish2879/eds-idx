        {
          "component": "text",
          "valueType": "string",
          "name": "privacyEmailText",
          "label": "Privacy contact email text",
          "description": "E.g. privacy@jswmotors.com.",
          "value": ""
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "privacyLink",
          "label": "Privacy notice link"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "privacyLinkText",
          "label": "Privacy notice link text",
          "description": "E.g. Full Privacy Notice.",
          "value": ""
        }
      ]
    },
    {
      "id": "reservation-form-section",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Section name",
          "description": "E.g. User Details. Groups the fields that follow it (up to the next section); read out by screen readers as the group's name (not shown in the design).",
          "value": ""
        }
      ]
    },
    {
      "id": "reservation-form-field",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "description": "Shown inside the field and read out by screen readers, e.g. First Name (required fields get a * added). The field’s kind follows its name: an email address, a mobile / phone number (with the +91 box) or text; first and last name sit side by side.",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "fieldName",
          "label": "Field name",
          "description": "Key of this value in the sent data, e.g. firstName. Leave empty to make it from the label.",
          "value": ""
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "required",
          "label": "Required",
          "value": false
        }
      ]
    },
    {
      "id": "reservation-form-dropdown",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "description": "Shown in the dropdown until a choice is made, e.g. Select City (a required one gets a * added).",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "fieldName",
          "label": "Field name",
          "description": "Key of the choice in the sent data, e.g. city. Leave empty to make it from the label.",
          "value": ""
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "required",
          "label": "Required",
          "value": false
        },
        {
          "component": "container",
          "name": "options",
          "label": "Cities",
          "description": "The dropdown’s choices: add a city per entry, edit, reorder or remove them here.",
