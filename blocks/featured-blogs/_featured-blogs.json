{
  "definitions": [
    {
      "title": "Featured Blogs",
      "id": "featured-blogs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Featured Blogs",
              "model": "featured-blogs"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "featured-blogs",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Style",
          "description": "Default shows featured blogs. Dissolve shows the latest blogs",
          "value": "",
          "options": [
            { "name": "Default", "value": "" },
            { "name": "Dissolve", "value": "dissolve" }
          ]
        },
        {
          "component": "aem-content",
          "name": "root",
          "label": "Root Path",
          "description": "Folder to pick blogs from, e.g. /blogs/technology."
        },
        {
          "component": "aem-content",
          "name": "excludePaths",
          "multi": true,
          "label": "Excluded Paths",
          "description": "Pages to leave out, e.g. category or listing pages inside the Root Path folder."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "heading",
          "label": "Heading",
          "description": "Maximum character limit: 30 characters.",
          "valueFormat": "regexp",
          "validation": {
            "maxLength": 30,
            "regExp": "^[\\s\\S]{0,30}$",
            "customErrorMsg": "Heading must be 30 characters or fewer."
          }
        },
        {
          "component": "aem-content",
          "name": "viewAll",
          "label": "View All Link",
          "description": "View All link path will only work with the Default Style."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "viewAllLabel",
          "label": "View All Label",
          "description": "View All label will only show with the Default Style.",
          "value": "View all",
          "validation": {
            "maxLength": 20,
            "customErrorMsg": "Use 20 characters or fewer."
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "index",
          "label": "Query Index Path",
          "description": "Index to read articles from",
          "required": true
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxBlogs",
          "label": "Maximum Blogs",
          "value": 3,
          "validation": {
            "numberMin": 3,
            "numberMax": 6
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "readMoreLabel",
          "label": "Read More Label",
          "value": "",
          "validation": {
            "maxLength": 20,
            "customErrorMsg": "Use 20 characters or fewer."
          }
        }
      ]
    }
  ],
  "filters": []
}