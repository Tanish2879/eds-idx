{
  "definitions": [
    {
      "title": "Content Listing",
      "id": "content-listing",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Content Listing",
              "model": "content-listing",
              "filter": "content-listing"
            }
          }
        }
      }
    },
    {
      "title": "Content Listing Tab",
      "id": "content-listing-tab",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Content Listing Tab",
              "model": "content-listing-tab"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "content-listing",
      "fields": [
        {
          "component": "aem-content",
          "name": "excludePaths",
          "multi": true,
          "label": "Excluded Paths",
          "description": "Pages to leave out of the listing (e.g. the listing's own landing page)."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "index",
          "label": "Query Index Path",
          "description": "Index to read articles from",
          "required": true
        }
      ]
    },
    {
      "id": "content-listing-tab",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Tab Title",
          "required": true,
          "description": "Maximum character limit: 30 characters. Maximum 5 tabs per listing.",
          "validation": {
            "maxLength": 30
          }
        },
        {
          "component": "aem-content",
          "name": "root",
          "label": "Root Path",
          "description": "Folder to list articles from"
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "tags",
          "label": "Tags Filter (Optional)"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "content-listing",
      "components": [
        "content-listing-tab"
      ]
    }
  ]
}
