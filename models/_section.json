{
  "definitions": [
    {
      "title": "Section",
      "id": "section",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "model": "section"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchor",
          "label": "Anchor",
          "description": "Optional. A short id such as safety, so a link to #safety scrolls to this section. Lowercase letters, numbers and dashes; use each one once per page."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "navLabel",
          "label": "Side navigation label",
          "description": "Optional: this section's name in the page's side navigation, e.g. Technology. The side navigation shows when at least one section has one."
        },
        {
          "component": "multiselect",
          "name": "style",
          "label": "Style",
          "description": "Combine as needed. Collage: Title, Text, 8 images. Statement: a short Title only. Side Panel: /modals/ pages only. Reserve Band: Title, links, 2 buttons.",
          "options": [
            {
              "name": "No Snap",
              "value": "no-snap"
            },
